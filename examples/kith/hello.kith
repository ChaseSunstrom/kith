// examples/hello.yaml in kith's own language: `kith apply -f examples/kith/hello.kith`.
Workload {
    metadata: { name: "hello" },
    spec: {
        template: {
            containers: [{
                name: "main",
                image: "mirror.gcr.io/library/busybox:1.36",
                command: ["sh", "-c", "while true; do echo hello from \$(hostname); sleep 5; done"],
                resources: { memory: "32Mi", cpu: "100m" },
            }],
        },
    },
}
