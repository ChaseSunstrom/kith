# kith OS's kernel: this, merged over x86_64_defconfig. No modules and no initramfs:
# whatever a machine needs to find its disk, check its root and reach the network is
# in the one kernel file, and the kernel mounts the root itself.
# CONFIG_MODULES is not set
CONFIG_LOCALVERSION="-kith"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_ZSTD=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# No kexec: a root workload with CAP_SYS_BOOT could load an unsigned kernel and leave dm-verity
# and the slots behind (nothing on kith OS calls it; os/vps.sh kexecs kith's kernel from the old host's kernel, so kith needs none).
# And the kernel locks itself down at integrity from the first instruction: no /dev/mem or
# /dev/port writes, no raw MSR, no ioperm, no unsigned module, no hibernation image, no ACPI
# table override. (Confidentiality would also shut /proc/kcore and kprobes: not asked.)
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# Disks and file systems. The root is squashfs under dm-verity, set up from the
# command line (dm-mod.create=); the state partition is ext4, later under dm-crypt.
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_EXT4_FS=y
# (A pod's storage limit is a project quota on the state's file system: the kernel
# refuses the write that would pass it. T-0470.)
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=y
# (/dev/fuse, for a unit given it as a Device of class other: a FUSE program in a
# container, as xdg-document-portal is. T-0438.)
CONFIG_FUSE_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFIVAR_FS=y
CONFIG_RD_ZSTD=y

# Shared volumes: a node serves its own over NFS 4.2, to the mesh only, and mounts another
# node's. kithd answers the kernel's questions itself (crates/kithd/src/share.rs): there is
# no mountd, no rpcbind and no mount.nfs here. (The NFS client itself is in the defconfig.)
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFSD=y
CONFIG_NFSD_V4=y

# Network cards (the common wired ones, and a VM's), and what the mesh and containers use.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_R8169=y
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
# (A card plugged into a PCIe slot after the boot, in a dock or a VM: the kernel makes its link,
# and kithd's re-scan brings it up (crates/kithd/src/init.rs, T-0089). The defconfig has no pciehp.)
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_IPV6=y
# (kithd asks DHCP from no address in a raw frame: crates/kithd/src/dhcp.rs.)
CONFIG_PACKET=y
CONFIG_WIREGUARD=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
# An exit's pods: rules by the link a packet came in on (both families), the mark their
# connections carry, and forgetting those connections by it (kith-mesh's exit.rs).
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CT_NETLINK=y

# Containers.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# As a guest, and as a host of microVMs (Phase 7).
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# The IOMMU drivers, Intel's and AMD's, pinned so a defconfig change can't drop them. Intel's
# is off by default here; os/features/vfio.config turns it on (with IRQ remapping) and adds vfio-pci.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# Keys: AES for the state partition, the TPM to seal to.
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# The firmware's event log is a file of securityfs (/sys/kernel/security/tpm0/binary_bios_measurements,
# which kithd reads to predict the PCRs of the next system, docs/adr-unlock.md): without it
# the kernel keeps the log to itself, and no key is sealed again or ahead (T-1180).
CONFIG_SECURITYFS=y

# A console on whatever screen the firmware set up, the keyboard and the power button.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_BUTTON=y

# A FIDO2 key on USB is a USB HID device read through /dev/hidraw* (docs/adr-fido2.md,
# T-0863). HID is named too: USB_HID depends on it and olddefconfig would drop USB_HID
# without it. CONFIG_UHID (/dev/uhid, which lets root make an input device out of nothing)
# is left out on purpose; the test-only os/features/uhid-test.config has it.
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HID=y

# Not on a headless node; desktops bring their own (Phase 6).
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_DRM_I915 is not set
# CONFIG_AGP is not set
# CONFIG_PCCARD is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_DEBUG_INFO_BTF is not set
