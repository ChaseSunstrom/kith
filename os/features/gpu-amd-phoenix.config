# AMD's graphics driver, for the GPU of a Ryzen 7040, 8040 or 8000G (Phoenix, Hawk Point:
# Radeon 780M, 760M, 740M), with only that GPU's firmware: /dev/dri/card* and renderD* for
# a workload that claims it, /dev/kfd for compute (ROCm), and the dmem cgroup, so a GPU
# share is a ceiling.
# pci: 1002:15bf 1002:15c8 1002:1900 1002:1901
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
CONFIG_HSA_AMD=y
CONFIG_CGROUP_DMEM=y
# firmware: amdgpu/gc_11_0_1_* amdgpu/gc_11_0_4_* amdgpu/psp_13_0_4_* amdgpu/psp_13_0_11_*
# firmware: amdgpu/dcn_3_1_4_* amdgpu/sdma_6_0_1* amdgpu/vcn_4_0_2*
