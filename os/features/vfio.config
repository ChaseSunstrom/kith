# Preparing a node's kernel to hand a PCI device (a GPU, a USB controller, a NIC) to a virtual
# machine: the IOMMU switched on (Intel's is built into every kith OS kernel but off by default;
# nothing on an installed node's command line can turn it on, so this does) with interrupt
# remapping, and vfio-pci built in. Binding a card to it, and `vms` on kith OS, come later.
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_IRQ_REMAP=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
