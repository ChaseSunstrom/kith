# modules: state
# The test of a feature whose modules live on the state partition, not in the root
# (ci/vm/modules-state.sh): one in-tree GPL driver, virtio-input, as a module. The line above
# has build.sh pack the modules and the firmware they name into kith-modules.img (squashfs)
# with a dm-verity tree, pin its root hash, salt and sizes in the root
# (/usr/share/kith/modules), and put both on the state partition as os/modules-a.img(+.verity);
# kithd maps it read-only through dm-verity at start and loads from there. No .ko is left in
# the root. A block or network driver as a module is refused with this line: the disk and the
# network come up before the state is mounted.
CONFIG_MODULES=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_MODULE_UNLOAD=y

# What the plain kernel has built in, and defconfig makes =m once modules are on (as in
# all.config): it stays built in.
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NF_LOG_ARP=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_X86_PKG_TEMP_THERMAL=y

# The driver on state (the plain kernel has none: QEMU's virtio-keyboard-pci device is its).
CONFIG_VIRTIO_INPUT=m
